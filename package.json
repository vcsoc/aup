{
  "name": "agent-usage-panel",
  "version": "0.2.0",
  "description": "Private, cross-platform AI agent usage and resource monitor inspired by Omarchy",
  "author": "Agent Usage Panel contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "npm run build && electron .",
    "demo": "npm run build && electron . --demo",
    "test": "vitest run",
    "prices:update": "npm run build && node scripts/update-prices.mjs",
    "test:smoke": "npm run build && node scripts/worker-smoke.mjs && node scripts/smoke.mjs && node scripts/host-smoke.mjs && node scripts/startup-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "systeminformation": "^5.31.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "overrides": { "global-agent": "^4.1.3" },
  "build": {
    "appId": "io.agentusage.panel",
    "productName": "Agent Usage Panel",
    "icon": "assets/icon.png",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "assets/**/*", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "asar": true,
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "category": "public.app-category.developer-tools", "hardenedRuntime": true },
    "win": { "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb", "rpm", "tar.gz"], "category": "Utility", "maintainer": "Agent Usage Panel contributors" }
  }
}
