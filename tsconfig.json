{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "lib": ["ES2022", "DOM"],
    "skipLibCheck": true, "types": ["node"], "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
